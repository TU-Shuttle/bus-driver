# Naver Cloud Platform Maps client ID
NAVER_MAP_CLIENT_ID=

# Android emulator에서 로컬 서버에 접속할 때의 기본값
BASE_URL=http://10.0.2.2:8080/
WS_URL=ws://10.0.2.2:8080/ws

# 서버(/ws) 기사 인증 토큰. 서버의 DRIVER_TOKEN 과 같은 값이어야 한다.
# 주의: 앱에 포함되는 공유 비밀값이라 APK 에서 추출될 수 있다. 기사별 인증이 필요해지면 로그인 기반으로 교체한다.
DRIVER_TOKEN=

# 릴리즈 서명(선택). 비워 두면 서명 없는 release APK가 나온다. 키스토어 파일은 저장소에 넣지 않는다.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
